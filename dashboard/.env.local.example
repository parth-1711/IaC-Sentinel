# ==============================================================================
# IaC Sentinel Dashboard — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' and fill in the values for your local environment:
#   cp .env.local.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# GitHub OAuth App
# ------------------------------------------------------------------------------
# Create one at: https://github.com/settings/developers > "New OAuth App"
# Authorization callback URL must be: <NEXTAUTH_URL>/api/auth/callback/github
#   e.g. http://localhost:3000/api/auth/callback/github
#
# NOTE ON SCOPE: this app requests the "repo" scope so it can list the private
# repositories the signed-in user can access (GitHub's classic OAuth scopes
# don't offer a narrower "read-only repo list" permission — "repo" is the only
# scope that includes private repo visibility). A GitHub App with fine-grained
# read-only "Metadata"/"Contents" permissions would be the tighter, more
# production-grade alternative if you want to harden this later.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# NextAuth
# ------------------------------------------------------------------------------
# Random secret used to encrypt session tokens. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# Base URL this app is served from (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------------------
# Same database the Python scanner (scanner/storage.py) writes scan history to.
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="iac_sentinel"
