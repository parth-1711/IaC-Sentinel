# ==============================================================================
# IaC Sentinel — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine (Google Gemini)
# ------------------------------------------------------------------------------
# Required for live AI risk explanations and automated HCL patch generation.
# If omitted or left empty, IaC Sentinel gracefully runs in deterministic
# compliance-assistant mode using built-in heuristic rules.
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Alternative environment variable recognized by google-generativeai:
# GOOGLE_API_KEY="your-google-api-key-here"

# Gemini model identifier (default: gemini-1.5-flash)
GEMINI_MODEL="gemini-1.5-flash"


# ------------------------------------------------------------------------------
# 2. Open Policy Agent (OPA) CLI
# ------------------------------------------------------------------------------
# Optional: Path to the OPA binary if it is not already installed in your system PATH.
# Windows example: "C:\\ProgramData\\chocolatey\\bin\\opa.exe"
# Linux/macOS example: "/usr/local/bin/opa"
# OPA_PATH=""


# ------------------------------------------------------------------------------
# 3. GitHub Integration (Optional / CI Emulation)
# ------------------------------------------------------------------------------
# Required only when testing PR commenting scripts locally or interacting
# with GitHub APIs outside of GitHub Actions runner workflows.
# GITHUB_TOKEN="ghp_yourPersonalAccessTokenHere"


# ------------------------------------------------------------------------------
# 4. MongoDB Audit Log
# ------------------------------------------------------------------------------
# Connection URI for the audit log store. Defaults to a local MongoDB instance.
# For MongoDB Atlas, use the connection string from your cluster's "Connect" dialog.
MONGO_URI="mongodb://localhost:27017"

# Database name used for scan history (default: iac_sentinel)
# MONGO_DB_NAME="iac_sentinel"
